{
  "name": "spark-circuit-to-wokwi",
  "private": true,
  "type": "module",
  "description": "circuit.json -> Wokwi diagram.json. Lives in the spark plugin; takes every path as an argument and the board from SPARK_BOARD_JSON.",
  "scripts": {
    "generate": "bun run cli.ts",
    "check": "bun run cli.ts --check",
    "test": "SPARK_BOARD_JSON=../../boards/firebeetle2-esp32s3.json bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tscircuit/circuit-json-util": "0.0.116",
    "@wokwi/diagram-lint": "0.1.1",
    "circuit-json": "0.0.500",
    "circuit-json-to-connectivity-map": "0.0.31"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
