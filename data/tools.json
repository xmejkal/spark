{
  "//": "The tools spark depends on (P82, docs/2026-10-03-tools-design.md). A person's ~/.local/share/spark/tools.json and a project's .spark/tools.json override any field of any entry; the project wins. `roles` points a job at a tool; `contracts` says what the job needs, and only this file states them.",
  "roles": {
    "pdf-text": "pdftotext",
    "simulator": "wokwi-cli",
    "board-engine": "tscircuit",
    "diagram-converter": "circuit-to-wokwi",
    "js-runtime": "node",
    "littlefs": "littlefs-python",
    "firmware-image": "micropython-esp32s3",
    "parts-search": "jlcpcb",
    "chip-docs": "espressif-docs",
    "bench": "sigrok",
    "ts-runtime": "bun"
  },
  "contracts": {
    "pdf-text": "page-text",
    "simulator": "wokwi-project",
    "board-engine": "tscircuit-board",
    "diagram-converter": "circuit-json-to-wokwi",
    "littlefs": "esp32-littlefs",
    "firmware-image": "micropython-esp32-bin"
  },
  "pdftotext": {
    "for": "reading a datasheet page by page (parts.py --read)",
    "kind": "path",
    "exe": "pdftotext",
    "meets": [
      "page-text"
    ],
    "install": {
      "brew": "brew install poppler",
      "apt": "sudo apt install poppler-utils"
    }
  },
  "wokwi-cli": {
    "for": "compiling custom chips (free, local) and running Wokwi scenarios (paid minutes)",
    "kind": "path",
    "exe": "wokwi-cli",
    "also": [
      "~/.local/bin/wokwi-cli",
      "~/.wokwi/bin/wokwi-cli",
      "~/bin/wokwi-cli"
    ],
    "meets": [
      "wokwi-project"
    ],
    "install": {
      "download": "/spark:setup — wokwi-cli 0.28.0 from github.com/wokwi/wokwi-cli/releases, its checksum checked"
    },
    "needs_account": "a Wokwi token in WOKWI_CLI_TOKEN — create one at wokwi.com/dashboard/ci",
    "account_env": "WOKWI_CLI_TOKEN",
    "fetch": {
      "file": "wokwi-cli",
      "executable": true,
      "platforms": {
        "macos-arm64": {
          "url": "https://github.com/wokwi/wokwi-cli/releases/download/v0.28.0/wokwi-cli-macos-arm64",
          "sha256": "0251a9868e17c4141eaa64e75f8fbd265c0dc0b296f902723d242b3aa6afae49"
        },
        "macos-x64": {
          "url": "https://github.com/wokwi/wokwi-cli/releases/download/v0.28.0/wokwi-cli-macos-x64",
          "sha256": "55a1adc391f592433b51c64b46c0af092db12248c9b8a81f981b58a29b5f1db5"
        },
        "linux-x64": {
          "url": "https://github.com/wokwi/wokwi-cli/releases/download/v0.28.0/wokwi-cli-linuxstatic-x64",
          "sha256": "9ae464374bc0ed5fb20560a4c648406dea79988d1877fc2d9252cb33ed856bb0"
        },
        "linux-arm64": {
          "url": "https://github.com/wokwi/wokwi-cli/releases/download/v0.28.0/wokwi-cli-linuxstatic-arm64",
          "sha256": "13c3a4ed5b4cf5618a009b4849f9c7ed4850967bb9d44472f20d86c9e00c5a50"
        }
      }
    },
    "//": "Not an npm package (npm has no wokwi-cli): Wokwi ships a binary per platform; checksums are GitHub's release digests, read 2026-10-03."
  },
  "tscircuit": {
    "for": "building the board spark writes",
    "kind": "npm",
    "exe": "tsci",
    "version": "0.1.2113",
    "core": "0.0.2600",
    "meets": [
      "tscircuit-board"
    ],
    "install": {
      "npm": "npm install --save-dev --save-exact @tscircuit/cli@{version} tscircuit@{core}"
    },
    "needs": [
      "bun"
    ],
    "packages": {
      "version": "@tscircuit/cli",
      "core": "tscircuit"
    }
  },
  "circuit-to-wokwi": {
    "for": "turning the built board into a Wokwi diagram",
    "kind": "bundled",
    "file": "tools/circuit-to-wokwi/dist/converter.mjs",
    "needs": [
      "node"
    ],
    "meets": [
      "circuit-json-to-wokwi"
    ]
  },
  "node": {
    "for": "running the bundled converter and npm tools",
    "kind": "path",
    "exe": "node",
    "version": "20",
    "install": {
      "brew": "brew install node"
    }
  },
  "littlefs-python": {
    "for": "packing the firmware's files into the flash image",
    "kind": "python",
    "module": "littlefs",
    "meets": [
      "esp32-littlefs"
    ],
    "install": {
      "pip": "python3 -m pip install --user littlefs-python"
    }
  },
  "micropython-esp32s3": {
    "for": "the interpreter the flash image starts with, for an ESP32-S3",
    "kind": "download",
    "file": "ESP32_GENERIC_S3-20260824-v1.29.0.bin",
    "url": "https://micropython.org/resources/firmware/ESP32_GENERIC_S3-20260824-v1.29.0.bin",
    "sha256": "1dd9dcd27ba2d6a1cb7f7b49a063f46d3d807d68b0151161233920228285e300",
    "meets": [
      "micropython-esp32-bin"
    ],
    "install": {
      "download": "/spark:setup add micropython-esp32s3"
    }
  },
  "jlcpcb": {
    "for": "finding parts with a datasheet link",
    "kind": "mcp",
    "owner": "spark",
    "needs": [
      "node"
    ],
    "meets": [
      "candidates-with-datasheet"
    ]
  },
  "espressif-docs": {
    "for": "searching Espressif's documentation",
    "kind": "mcp",
    "owner": "spark",
    "needs": [
      "node"
    ],
    "meets": [
      "maker-docs-search"
    ],
    "note": "mcp-remote needs Node 20 or newer (docs/mcp.md)"
  },
  "wokwi-mcp": {
    "for": "driving a simulation interactively (paid minutes)",
    "kind": "mcp",
    "on": false,
    "mcp": {
      "command": "wokwi-cli",
      "args": [
        "mcp"
      ]
    },
    "needs": [
      "wokwi-cli"
    ]
  },
  "sigrok": {
    "for": "reading a logic analyzer at the bench",
    "kind": "mcp",
    "on": false,
    "mcp": {
      "command": "sigrok-mcp-server"
    },
    "needs": [
      "sigrok-cli"
    ],
    "needs_hardware": "the instrument plugged into this machine, and sigrok-mcp-server from github.com/KenosInc/sigrok-mcp-server"
  },
  "sigrok-cli": {
    "for": "talking to the instrument — what the sigrok server runs",
    "kind": "path",
    "exe": "sigrok-cli",
    "install": {
      "brew": "brew install sigrok-cli",
      "apt": "sudo apt install sigrok-cli"
    }
  },
  "bun": {
    "for": "running tscircuit's tsci, whose first line is `#!/usr/bin/env bun` — so bun must be on the PATH",
    "kind": "path",
    "exe": "bun",
    "install": {
      "npm": "npm install -g bun",
      "brew": "brew install oven-sh/bun/bun"
    }
  }
}
